{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./public/js",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "removeComments": false,
    "sourceMap": false,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
